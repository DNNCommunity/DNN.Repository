<?xml version="1.0" encoding="utf-8" ?>

<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CompanyName>DotNetNuke</CompanyName>
    <ModuleName>Repository</ModuleName>
    <ModuleIconFile>icon_repository_32px.gif</ModuleIconFile>
    <DotNetNukeDir>..\..\</DotNetNukeDir>
    <DeployModuleFolder>$(DotNetNukeDir)DesktopModules\Repository</DeployModuleFolder>
    <DeployDashboardFolder>$(DotNetNukeDir)DesktopModules\Dashboard</DeployDashboardFolder>
    <InstallDir>$(MSBuildProjectDirectory)\Install</InstallDir>
    <BinDir>$(DotNetNukeDir)\bin</BinDir>
  </PropertyGroup>

    <Target Name="PackageModule">
      <CallTarget Targets="DeployModule" Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' " />
      <CallTarget Targets="CreateInstallPackages" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' " />
    </Target>

    <Target Name="DeleteTempFiles">
      <RemoveDir Directories ="$(MSBuildProjectDirectory)\Package" />
      <RemoveDir Directories ="$(MSBuildProjectDirectory)\RepositoryResourcesZip" />
      <RemoveDir Directories ="$(MSBuildProjectDirectory)\DashboardResourcesZip" />
      <ItemGroup>
        <CleanupInclude Include="DNN_$(ModuleName)_*_Install.zip" Exclude="Install\**" />
        <CleanupInclude Include="DNN_$(ModuleName)_*_Source.zip" Exclude="Install\**" />
      </ItemGroup>
      <Delete Files="@(CleanupInclude)" />
      <Delete Files="$(MSBuildProjectDirectory)\RepositoryResources.zip" />
      <Delete Files="$(MSBuildProjectDirectory)\DashboardResources.zip" />
    </Target>

    <Target Name="DeployModule">
      <!-- <Delete Files="$(MSBuildProjectDirectory)\DebugDeploy.zip" /> -->

      <!-- Assemblies -->
      <ItemGroup>
        <DebugAssemblies Include="$(MSBuildProjectDirectory)\bin\*.dll;$(MSBuildProjectDirectory)\bin\*.pdb" />
      </ItemGroup>
      <Copy SourceFiles="@(DebugAssemblies)" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" ContinueOnError="true" />

      <!-- Copy other files to deploy folder -->
      <ItemGroup>
        <DeployInclude Include="**\*.ascx" />
        <DeployInclude Include="**\*.asmx" />
        <DeployInclude Include="**\*.css" />
        <DeployInclude Include="**\*.xsl" />
        <DeployInclude Include="**\*.html" />
        <DeployInclude Include="**\*.htm" />
        <DeployInclude Include="**\*.resx" />
        <DeployInclude Include="**\*.jpg" />
        <DeployInclude Include="**\*.png" />
        <DeployInclude Include="**\*.gif" />
        <DeployInclude Include="**\*.xml" Exclude="**\obj\**;**\_ReSharper*\**;**\.git\**;**\packages\**" />
        <DeployInclude Include="**\*.aspx" />
        <DeployInclude Include="**\*.js" />
        <DeployInclude Include="*.txt" />
      </ItemGroup>
      <Zip Files="@(DeployInclude)" ZipFileName="$(MSBuildProjectDirectory)\DebugDeploy.zip"
           WorkingDirectory="$(MSBuildProjectDirectory)" />
      <Unzip ZipFileName="$(MSBuildProjectDirectory)\DebugDeploy.zip" TargetDirectory="$(DeployModuleFolder)" />
      <Delete Files="$(MSBuildProjectDirectory)\DebugDeploy.zip" />

      <!-- Copy Dashboard files to Dashboard deploy folder -->
      <ItemGroup>
        <DashboardDeployInclude Include="DashboardSettings.ascx" />
        <DashboardDeployInclude Include="DashboardSettings.ascx.cs" />
        <DashboardDeployInclude Include="RepositoryDashboard.ascx" />
        <DashboardDeployInclude Include="RepositoryDashboard.ascx.cs" />
        <DashboardDeployInclude Include="App_LocalResources\DashboardSettings.ascx.resx" />
        <DashboardDeployInclude Include="App_LocalResources\RepositoryDashboard.ascx.resx" />
      </ItemGroup>
      <Copy SourceFiles="@(DashboardDeployInclude)" DestinationFolder="$(DeployDashboardFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    </Target>

    <Target Name="CreateInstallPackages">

      <!-- Set the module version -->
      <XmlRead Prefix="n" Namespace="http://schemas.microsoft.com/developer/msbuild/2003"
               XPath="dotnetnuke/packages/package[1]/@version"
               XmlFileName="$(MSBuildProjectDirectory)\DotNetNuke_DotNetNuke.Repository.dnn">
        <Output TaskParameter="Value" PropertyName="ModuleVersion" />
      </XmlRead>
      <AssemblyInfo AssemblyVersion="$(ModuleVersion).00" CodeLanguage="CS"></AssemblyInfo>
      <Message Text="MSBUILD: Assembly Version set to: $(ModuleVersion)" Importance="high"></Message>

      <!-- Remove the temporary folders in case previous build failed in the middle of an operation-->
      <MSBuild Projects="$(MSBuildProjectFile)" Targets="DeleteTempFiles" Properties="step=start"></MSBuild>

			<!-- Set the files to include in Repository install package -->
			<ItemGroup>
				<RepositoryInstallInclude Include="**\*.ascx" Exclude="packages\**;DashboardSettings.ascx;RepositoryDashboard.ascx" />
				<RepositoryInstallInclude Include="**\*.asmx" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\*.css" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\*.html" Exclude="packages\**;Tests\**" />
				<RepositoryInstallInclude Include="**\*.htm" Exclude="packages\**;package\**" />
				<RepositoryInstallInclude Include="**\*.resx" Exclude="packages\**;App_LocalResources\DashboardSettings.ascx.resx;App_LocalResources\RepositoryDashboard.ascx.resx" />
				<RepositoryInstallInclude Include="**\*.aspx" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\*.js" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\img\**" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\images\**" Exclude="packages\**" />
				<RepositoryInstallInclude Include="**\Templates\**" />
				<RepositoryInstallInclude Include="icon_repository_32px.gif" />
			</ItemGroup>

			<!-- Set the files to include in Dashboard install package -->
			<ItemGroup>
				<DashboardInstallInclude Include="**\DashboardSettings.ascx" />
				<DashboardInstallInclude Include="**\RepositoryDashboard.ascx" />
				<DashboardInstallInclude Include="**\DashboardSettings.ascx.resx" />
				<DashboardInstallInclude Include="**\RepositoryDashboard.ascx.resx" />
			</ItemGroup>

			<!-- Set the files to include in Repository source package -->
			<ItemGroup>
				<RepositorySourceInclude Include="**\*.ascx" Exclude="DashboardSettings.ascx;RepositoryDashboard.ascx" />
				<RepositorySourceInclude Include="**\*.asmx" />
				<RepositorySourceInclude Include="**\*.css" />
				<RepositorySourceInclude Include="**\*.xsl" />
				<RepositorySourceInclude Include="**\*.html" />
				<RepositorySourceInclude Include="**\*.htm" />
				<RepositorySourceInclude Include="**\*.resx" Exclude="App_LocalResources\DashboardSettings.ascx.resx;App_LocalResources\RepositoryDashboard.ascx.resx" />
				<RepositorySourceInclude Include="**\*.xml" Exclude="**\obj\**;**\_ReSharper*\**;**\.git\**;**\packages\**" />
				<RepositorySourceInclude Include="**\*.aspx" />
				<RepositorySourceInclude Include="**\*.js" />
				<RepositorySourceInclude Include="**\images\**" />
				<RepositorySourceInclude Include="**\*.cs" Exclude="**\obj\**" />
				<RepositorySourceInclude Include="**\*.cs.designer" />
				<RepositorySourceInclude Include="**\*.csproj" />
				<RepositorySourceInclude Include="**\*.targets" Exclude="**\packages\**" />
				<RepositorySourceInclude Include="**\*.sln" />
				<RepositorySourceInclude Include="**\img\**" Exclude="packages\**" />
				<RepositorySourceInclude Include="**\images\**" Exclude="packages\**" />
				<RepositorySourceInclude Include="**\Templates\**" />
				<RepositorySourceInclude Include="icon_repository_32px.gif" />
			</ItemGroup>

			<!-- Set the files to include in Dashboard source package -->
			<ItemGroup>
				<DashboardSourceInclude Include="**\DashboardSettings.ascx" />
				<DashboardSourceInclude Include="**\RepositoryDashboard.ascx" />
				<DashboardSourceInclude Include="**\DashboardSettings.ascx.resx" />
				<DashboardSourceInclude Include="**\RepositoryDashboard.ascx.resx" />
				<DashboardSourceInclude Include="DashboardSettings.ascx.cs" />
				<DashboardSourceInclude Include="RepositoryDashboard.ascx.cs" />
			</ItemGroup>

      <!-- Files for setup -->
      <CreateItem Include="$(MSBuildProjectDirectory)\DotNetNuke_DotNetNuke.Repository.dnn">
        <Output TaskParameter="Include" ItemName="PackageManifestFiles" />
      </CreateItem>
      <CreateItem Include="**\License.html">
        <Output TaskParameter="Include" ItemName="PackageTxtFiles" />
      </CreateItem>
      <CreateItem Include="**\ReleaseNotes.html">
        <Output TaskParameter="Include" ItemName="PackageTxtFiles" />
      </CreateItem>
      <CreateItem Include="**\*.SqlDataProvider">
        <Output TaskParameter="Include" ItemName="SqlDataProviderFiles" />
      </CreateItem>
      <CreateItem Include="*.txt">
        <Output TaskParameter="Include" ItemName="CleanupFiles" />
      </CreateItem>

      <!-- Grab files for install setup -->
      <Copy SourceFiles="$(MSBuildProjectDirectory)\bin\$(AssemblyName).dll" DestinationFolder="$(MSBuildProjectDirectory)\Package\bin"/>
      <Copy SourceFiles="@(SqlDataProviderFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package\%(RecursiveDir)" />
      <Copy SourceFiles="@(PackageManifestFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />
      <Copy SourceFiles="@(PackageTxtFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />
      <Copy SourceFiles="@(CleanupFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />

      <!-- Create RepositoryResources.zip -->
      <Copy SourceFiles="@(RepositoryInstallInclude)" DestinationFolder="$(MSBuildProjectDirectory)\RepositoryResourcesZip\%(RecursiveDir)" />
      <CreateItem Include="$(MSBuildProjectDirectory)\RepositoryResourcesZip\**\*.*">
        <Output TaskParameter="Include" ItemName="RepositoryResourcesContent" />
      </CreateItem>
      <Zip Files="@(RepositoryResourcesContent)" WorkingDirectory="$(MSBuildProjectDirectory)\RepositoryResourcesZip" ZipFileName="RepositoryResources.zip"/>
      <Copy SourceFiles="$(MSBuildProjectDirectory)\RepositoryResources.zip" DestinationFolder="package/" />

      <!-- Create DashboardResources.zip -->
      <Copy SourceFiles="@(DashboardInstallInclude)" DestinationFolder="$(MSBuildProjectDirectory)\DashboardResourcesZip\%(RecursiveDir)" />
      <CreateItem Include="$(MSBuildProjectDirectory)\DashboardResourcesZip\**\*.*">
        <Output TaskParameter="Include" ItemName="DashboardResourcesContent" />
      </CreateItem>
      <Zip Files="@(DashboardResourcesContent)" WorkingDirectory="$(MSBuildProjectDirectory)\DashboardResourcesZip" ZipFileName="DashboardResources.zip"/>
      <Copy SourceFiles="$(MSBuildProjectDirectory)\DashboardResources.zip" DestinationFolder="package/" />
      <CreateItem Include="$(MSBuildProjectDirectory)\package\**\*.*">
        <Output TaskParameter="Include" ItemName="OutputContent" />
      </CreateItem>

      <!-- Create the install package -->
      <Zip Files="@(OutputContent)" WorkingDirectory="$(MSBuildProjectDirectory)\Package" ZipFileName="DNN_Repository_$(ModuleVersion)_Install.zip" />
      <Copy SourceFiles="$(MSBuildProjectDirectory)\DNN_Repository_$(ModuleVersion)_Install.zip" DestinationFolder="install/" />

      <!-- Remove the temporary folders-->
      <MSBuild Projects="$(MSBuildProjectFile)" Targets="DeleteTempFiles" Properties="step=install"></MSBuild>

      <!-- Grab files for source setup -->
      <Copy SourceFiles="$(MSBuildProjectDirectory)\bin\$(AssemblyName).dll" DestinationFolder="$(MSBuildProjectDirectory)\Package\bin"/>
      <Copy SourceFiles="$(MSBuildProjectDirectory)\bin\$(AssemblyName).pdb" DestinationFolder="$(MSBuildProjectDirectory)\Package\bin"/>
      <Copy SourceFiles="@(SqlDataProviderFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package\%(RecursiveDir)" />
      <Copy SourceFiles="@(PackageManifestFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />
      <Copy SourceFiles="@(PackageTxtFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />
      <Copy SourceFiles="@(CleanupFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Package" />

      <!-- Create RepositoryResources.zip for source package -->
      <Copy SourceFiles="@(RepositorySourceInclude)" DestinationFolder="$(MSBuildProjectDirectory)\RepositoryResourcesZip\%(RecursiveDir)" />
      <CreateItem Include="$(MSBuildProjectDirectory)\RepositoryResourcesZip\**\*.*">
        <Output TaskParameter="Include" ItemName="RepositorySourceResourcesContent" />
      </CreateItem>
      <Zip Files="@(RepositorySourceResourcesContent)" WorkingDirectory="$(MSBuildProjectDirectory)\RepositoryResourcesZip" ZipFileName="RepositoryResources.zip"/>
      <Copy SourceFiles="$(MSBuildProjectDirectory)\RepositoryResources.zip" DestinationFolder="package/" />

      <!-- Create DashboardResources.zip for source package -->
      <Copy SourceFiles="@(DashboardSourceInclude)" DestinationFolder="$(MSBuildProjectDirectory)\DashboardResourcesZip\%(RecursiveDir)" />
      <CreateItem Include="$(MSBuildProjectDirectory)\DashboardResourcesZip\**\*.*">
        <Output TaskParameter="Include" ItemName="DashboardSourceResourcesContent" />
      </CreateItem>
      <Zip Files="@(DashboardSourceResourcesContent)" WorkingDirectory="$(MSBuildProjectDirectory)\DashboardResourcesZip" ZipFileName="DashboardResources.zip"/>
      <Copy SourceFiles="$(MSBuildProjectDirectory)\DashboardResources.zip" DestinationFolder="package/" />
      <CreateItem Include="$(MSBuildProjectDirectory)\package\**\*.*">
        <Output TaskParameter="Include" ItemName="SourceOutputContent" />
      </CreateItem>

      <!-- Create the install package -->
      <Zip Files="@(SourceOutputContent)" WorkingDirectory="$(MSBuildProjectDirectory)\Package" ZipFileName="DNN_Repository_$(ModuleVersion)_Source.zip" />
      <Copy SourceFiles="$(MSBuildProjectDirectory)\DNN_Repository_$(ModuleVersion)_Source.zip" DestinationFolder="install/" />

      <!-- Remove the temporary folders-->
      <MSBuild Projects="$(MSBuildProjectFile)" Targets="DeleteTempFiles" Properties="step=source"></MSBuild>
      <CallTarget Targets="DeleteTempFiles" UseResultsCache="false" />
    </Target>
</Project>
